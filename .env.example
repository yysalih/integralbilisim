# Medya CDN (Bunny) — sonunda / olmadan
VITE_MEDIA_CDN_URL=https://integralbilisim.b-cdn.net

# İletişim formu e-posta gönderimi (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@integralbilisim.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Kanonik site adresi (custom domain bağlandığında güncellenir)
VITE_SITE_URL=https://integralbilisim.com
# Google Analytics 4 ölçüm kimliği. Tanımlı değilse çerez bildirimi hiç gösterilmez.
VITE_GA4_ID=
# PageSpeed Insights API anahtarı (Google Cloud > PageSpeed Insights API).
# Tanımsızsa anahtarsız çağrı yapılır; ortak günlük kota sık dolduğu için
# hız kategorisi "ölçülemedi" olarak işaretlenebilir.
# Sunucuda okunur, tarayıcıya inmez.
PSI_API_KEY=

# Supabase — blog içeriği ve lead kayıtları
# URL ve anon anahtar: Supabase panel > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role yalnızca sunucuda kullanılır, asla tarayıcıya verilmez
SUPABASE_SERVICE_ROLE_KEY=
