# Medya CDN (Bunny) — sonunda / olmadan
VITE_MEDIA_CDN_URL=https://integralbilisim.b-cdn.net

# Form bildirimleri — kendi SMTP sunucunuz (ör. DirectAdmin e-posta hesabı)
SMTP_HOST=mail.integralbilisim.com
SMTP_PORT=465
# 465 için true (SSL), 587 için false (STARTTLS)
SMTP_SECURE=true
SMTP_USER=bildirim@integralbilisim.com
SMTP_PASS=
# Gönderen adres; boşsa SMTP_USER kullanılır
SMTP_FROM=
CONTACT_TO_EMAIL=info@integralbilisim.com

# Kanonik site adresi (custom domain bağlandığında güncellenir)
VITE_SITE_URL=https://integralbilisim.com
# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX). Sunucuda çalışma anında okunur;
# tanımlı değilse çerez bildirimi hiç gösterilmez ve GA4 yüklenmez.
GA4_ID=
# Yönetim paneli adresi (CORS izni). Birden fazlaysa virgülle ayırın; yerel geliştirme
# için http://localhost:3000 eklenebilir. Boşsa https://admin.integralbilisim.com.
ADMIN_ORIGIN=https://admin.integralbilisim.com
# Bunny Storage: yönetim panelinden görsel yükleme (yalnızca sunucuda okunur).
# Zone parolası: Bunny > Storage > zone > FTP & API Access > Password.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
# Varsayılan Falkenstein. Başka bölge: ny.storage.bunnycdn.com, la.storage.bunnycdn.com ...
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# PageSpeed Insights API anahtarı (Google Cloud > PageSpeed Insights API).
# Tanımsızsa anahtarsız çağrı yapılır; ortak günlük kota sık dolduğu için
# hız kategorisi "ölçülemedi" olarak işaretlenebilir.
# Sunucuda okunur, tarayıcıya inmez.
PSI_API_KEY=

# Supabase — blog içeriği ve lead kayıtları
# URL ve anon anahtar: Supabase panel > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role yalnızca sunucuda kullanılır, asla tarayıcıya verilmez
SUPABASE_SERVICE_ROLE_KEY=
